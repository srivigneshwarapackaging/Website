{
  "extends": "./frontend/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./frontend/*"],
      "@/backend/*": ["./backend/*"],
      "@/shared/*": ["./shared/*"]
    }
  },
  "include": [
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "backend/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": ["node_modules", "frontend/.next"]
}
